generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Order {
  id                  String   @id @default(cuid())
  platformOrderNumber String   @unique
  city                String
  fleetId             String?
  serviceDate         String
  pickupDateTime      DateTime
  pickupAddress       String
  dropoffAddress      String
  passengerName       String
  passengerPhone      String
  flightNumber        String?
  platformVehicleType String
  seatCount           Int?
  adults              Int      @default(0)
  children            Int      @default(0)
  luggage             Int      @default(0)
  childSeatLine       String?
  meetGreetLine       String?
  otherNotes          String?
  rawSource           String?
  status              String   @default("PENDING_DISPATCH")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  fleet         Fleet?                 @relation(fields: [fleetId], references: [id])
  driverDetail  DriverDetail?
  driverVehicleAssignments OrderDriverVehicleAssignment[]
  dispatchLinks DispatchBatchOrder[]
  iwayLinks     IwayReturnBatchOrder[]
  activityLogs  ActivityLog[]
  driverConfirmations DriverDetailConfirmation[]
  customerNotifications CustomerNotification[]
  customerInboundMessages CustomerInboundMessage[]
  customerCommunicationExceptions CustomerCommunicationException[]
  iwayMailEvents IwayMailEvent[]
  iwayCancellationCases IwayCancellationCase[]
  iwayChangeDrafts IwayChangeDraft[]
  customerConfirmationStatus String?
  customerConfirmedAt DateTime?
  customerLargeLuggageCount Int?
  customerCarryOnCount Int?
  customerStrollerCount Int?
  customerBulkyItems String?
  customerLuggageUpdatedAt DateTime?

  @@index([serviceDate, city, fleetId])
  @@index([status, pickupDateTime])
  @@index([customerConfirmationStatus])
}

model Fleet {
  id        String   @id @default(cuid())
  name      String
  city      String
  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  dispatchBatches DispatchBatch[]

  @@unique([name, city])
}

model DriverDetail {
  id                    String    @id @default(cuid())
  orderId               String    @unique
  confirmedDriverName   String?
  rawDriverPhone        String?
  normalizedDriverPhone String?
  confirmedVehicleModel String?
  confirmedVehicleCategory String?
  licensePlate          String?
  driverProfileId       String?
  vehicleProfileId      String?
  thaiDriverName        String?
  driverNameSource      String    @default("MANUAL")
  iwayDriverName        String?
  rawReply              String?
  confirmedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverProfile DriverProfile? @relation(fields: [driverProfileId], references: [id], onDelete: SetNull)
  vehicleProfile VehicleProfile? @relation(fields: [vehicleProfileId], references: [id], onDelete: SetNull)

  @@index([driverProfileId])
  @@index([vehicleProfileId])
}

// 独立司机档案只从本功能上线后的资料保存动作建立；不会从旧订单回填或猜测合并。
model DriverProfile {
  id                   String   @id @default(cuid())
  displayName          String   @default("无名氏")
  thaiName             String?
  confirmedEnglishName String?
  nameSource           String   @default("UNKNOWN")
  mergedIntoId         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  mergedInto           DriverProfile? @relation("DriverProfileMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedProfiles       DriverProfile[] @relation("DriverProfileMerge")
  phones               DriverPhone[]
  details              DriverDetail[]
  assignments          OrderDriverVehicleAssignment[]
  nameHistory          DriverNameHistory[]
  temporaryNames       TemporaryDriverName[]
  mergeSources         DriverProfileMerge[] @relation("MergeSource")
  mergeTargets         DriverProfileMerge[] @relation("MergeTarget")

  @@index([displayName])
  @@index([mergedIntoId])
}

model DriverPhone {
  id              String   @id @default(cuid())
  driverProfileId String
  rawPhone        String
  normalizedPhone String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)

  @@unique([normalizedPhone])
  @@index([driverProfileId])
}

model DriverNameHistory {
  id              String   @id @default(cuid())
  driverProfileId String
  name            String
  nameSource      String
  thaiName        String?
  createdAt       DateTime @default(now())

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)

  @@index([driverProfileId, createdAt])
}

model TemporaryDriverName {
  id              String   @id @default(cuid())
  driverProfileId String
  orderId         String   @unique
  generatedName   String
  generation      Int      @default(1)
  createdAt       DateTime @default(now())
  regeneratedAt   DateTime?

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)

  @@index([driverProfileId, createdAt])
}

model VehicleProfile {
  id              String   @id @default(cuid())
  rawLicensePlate String?
  normalizedPlate String?  @unique
  brand           String?
  vehicleModel    String?
  vehicleCategory String?
  photoPath       String?
  dataSource      String   @default("MANUAL")
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  details      DriverDetail[]
  assignments  OrderDriverVehicleAssignment[]

  @@index([vehicleModel])
}

// 每次确认或改写司机/车辆资料都保留一条搭配记录；旧记录只关闭，不删除。
model OrderDriverVehicleAssignment {
  id               String   @id @default(cuid())
  orderId          String
  driverProfileId  String?
  vehicleProfileId String?
  driverNameForIway String?
  driverNameSource String   @default("MANUAL")
  orderStatus      String
  isCurrent        Boolean  @default(true)
  assignedAt       DateTime @default(now())
  endedAt          DateTime?
  endReason        String?

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverProfile  DriverProfile? @relation(fields: [driverProfileId], references: [id], onDelete: SetNull)
  vehicleProfile VehicleProfile? @relation(fields: [vehicleProfileId], references: [id], onDelete: SetNull)

  @@index([orderId, isCurrent])
  @@index([driverProfileId, assignedAt])
  @@index([vehicleProfileId, assignedAt])
}

model DriverProfileMerge {
  id                 String   @id @default(cuid())
  sourceProfileId    String
  targetProfileId    String
  operator           String?
  summary            String
  createdAt          DateTime @default(now())

  sourceProfile DriverProfile @relation("MergeSource", fields: [sourceProfileId], references: [id], onDelete: Restrict)
  targetProfile DriverProfile @relation("MergeTarget", fields: [targetProfileId], references: [id], onDelete: Restrict)

  @@index([sourceProfileId, createdAt])
  @@index([targetProfileId, createdAt])
}

model DispatchBatch {
  id              String    @id @default(cuid())
  city            String
  fleetId         String
  serviceDate     String
  ruleVersion     String
  contentSnapshot String
  copiedAt        DateTime?
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())

  orders DispatchBatchOrder[]
  fleetReplies FleetReply[]
  fleet Fleet @relation(fields: [fleetId], references: [id])

  @@index([serviceDate, city, fleetId])
}

model FleetReply {
  id              String    @id @default(cuid())
  dispatchBatchId String?
  candidateOrderIds String?
  rawText         String
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dispatchBatch DispatchBatch? @relation(fields: [dispatchBatchId], references: [id], onDelete: SetNull)
  images        FleetReplyImage[]
  extractions   AiExtraction[]
  confirmations DriverDetailConfirmation[]

  @@index([dispatchBatchId, createdAt])
}

model FleetReplyImage {
  id               String   @id @default(cuid())
  fleetReplyId     String
  storagePath      String
  originalFilename String?
  mimeType         String
  uploadedAt       DateTime @default(now())

  fleetReply FleetReply @relation(fields: [fleetReplyId], references: [id], onDelete: Cascade)

  @@index([fleetReplyId])
}

model AiExtraction {
  id                  String   @id @default(cuid())
  fleetReplyId        String
  provider            String
  modelName           String?
  promptVersion       String
  rawModelJson        String?
  validatedResultJson String?
  status              String
  errorMessage        String?
  createdAt           DateTime @default(now())

  fleetReply FleetReply @relation(fields: [fleetReplyId], references: [id], onDelete: Cascade)

  @@index([fleetReplyId, createdAt])
}

model DriverDetailConfirmation {
  id                  String   @id @default(cuid())
  orderId             String
  fleetReplyId        String
  extractionId        String?
  finalDriverName     String
  finalPhone          String
  finalPlate          String
  finalVehicleModel   String
  confirmedBy         String?
  confirmedAt         DateTime @default(now())
  rulesVersion        String

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fleetReply FleetReply  @relation(fields: [fleetReplyId], references: [id], onDelete: Cascade)

  @@index([orderId, confirmedAt])
  @@index([fleetReplyId])
}

model DispatchBatchOrder {
  dispatchBatchId String
  orderId         String
  dispatchBatch   DispatchBatch @relation(fields: [dispatchBatchId], references: [id], onDelete: Cascade)
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([dispatchBatchId, orderId])
}

model IwayReturnBatch {
  id              String    @id @default(cuid())
  serviceDate     String
  ruleVersion     String
  contentSnapshot String
  copiedAt        DateTime?
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())

  orders IwayReturnBatchOrder[]

  @@index([serviceDate])
}

model IwayReturnBatchOrder {
  iwayReturnBatchId String
  orderId           String
  driverNameSnapshot String?
  driverNameSourceSnapshot String?
  iwayReturnBatch   IwayReturnBatch @relation(fields: [iwayReturnBatchId], references: [id], onDelete: Cascade)
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([iwayReturnBatchId, orderId])
}

model RuleVersion {
  id          String   @id @default(cuid())
  version     String   @unique
  yamlContent String
  isCurrent   Boolean  @default(false)
  publishedBy String?
  publishedAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  orderId   String?
  action    String
  actor     String?
  metadata  String?
  createdAt DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model DuplicateReview {
  id             String    @id @default(cuid())
  incomingKey    String
  candidateOrder String?
  decision       String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([incomingKey])
}

model ImportSyncRun {
  id             String    @id @default(cuid())
  connector      String
  status         String
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdCount   Int       @default(0)
  updatedCount   Int       @default(0)
  cancelledCount Int       @default(0)
  skippedCount   Int       @default(0)
  errorMessage   String?

  @@index([connector, startedAt])
}

model ImportedSourceMessage {
  id          String    @id @default(cuid())
  connector   String
  externalId  String
  action      String
  sourceText  String
  orderId     String?
  receivedAt  DateTime?
  processedAt DateTime  @default(now())

  @@unique([connector, externalId])
  @@index([orderId])
}

// 飞书邮箱中的 iWay 邮件先保存为不可重复的事件，再决定是否改变订单状态。
// 这样邮件重放、乱序或格式不明确时，都不会静默覆盖人工业务操作。
model IwayMailEvent {
  id          String   @id @default(cuid())
  externalId  String   @unique
  sender      String?
  subject     String?
  eventType   String
  disposition String
  orderId     String?
  eventAt     DateTime?
  reason      String?
  createdAt   DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  cancellationCase IwayCancellationCase?
  changeDraft IwayChangeDraft?

  @@index([orderId, eventAt])
  @@index([eventType, disposition, createdAt])
}

// 每次外部取消都保留一份独立的费用/通知处理依据；不删除司机、车辆或历史派单资料。
model IwayCancellationCase {
  id                      String   @id @default(cuid())
  orderId                 String
  mailEventId             String   @unique
  previousStatus          String
  cancellationReason      String?
  mailReceivedAt          DateTime?
  processedAt             DateTime @default(now())
  fleetNotificationStatus String   @default("NOT_REQUIRED")
  fleetNotifiedAt         DateTime?
  fleetNotifiedBy         String?
  assignmentSnapshot      String?
  restoredAt              DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mailEvent IwayMailEvent @relation(fields: [mailEventId], references: [id], onDelete: Restrict)

  @@index([orderId, processedAt])
  @@index([fleetNotificationStatus, createdAt])
}

// 修改邮件只保存待确认差异，绝不自动覆盖已派车订单。
model IwayChangeDraft {
  id          String   @id @default(cuid())
  orderId     String
  mailEventId String   @unique
  changes     String
  status      String   @default("PENDING_REVIEW")
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mailEvent IwayMailEvent @relation(fields: [mailEventId], references: [id], onDelete: Restrict)

  @@index([orderId, status, createdAt])
}

// 一条 AirportGuide 就是一份可保留的指引版本。新版本启用时，旧版本保留但停用，
// 使后续通知快照不会依赖会被改写的当前文案。
model AirportGuide {
  id            String   @id @default(cuid())
  airportName   String
  iataCode      String?
  terminal      String?
  matchKey      String
  guideText     String
  isActive      Boolean  @default(true)
  deactivatedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aliases AirportGuideAlias[]
  images  AirportGuideImage[]

  @@index([iataCode, isActive])
  @@index([isActive, updatedAt])
  @@index([matchKey])
}

model AirportGuideAlias {
  id              String   @id @default(cuid())
  airportGuideId  String
  matchKind       String   @default("ALIAS")
  value           String
  normalizedValue String
  createdAt       DateTime @default(now())

  airportGuide AirportGuide @relation(fields: [airportGuideId], references: [id], onDelete: Cascade)

  @@unique([airportGuideId, matchKind, normalizedValue])
  @@index([matchKind, normalizedValue])
}

model AirportGuideImage {
  id               String   @id @default(cuid())
  airportGuideId   String
  storageBucket    String
  storagePath      String
  originalFilename String?
  mimeType         String
  byteSize         Int?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  airportGuide AirportGuide @relation(fields: [airportGuideId], references: [id], onDelete: Cascade)

  @@unique([storageBucket, storagePath])
  @@index([airportGuideId, sortOrder])
}

model RegionNotificationSetting {
  id                          String   @id @default(cuid())
  region                      String   @unique
  customerWhatsAppEnabled     Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

// 本阶段只建立 outbox/历史快照，不接入任何 WhatsApp 发送行为。
// JSON 快照为后续入站回复、行李识别和司机资料更新比较保留扩展空间。
model CustomerNotification {
  id                    String   @id @default(cuid())
  orderId               String
  notificationType      String
  recipientPhone        String
  status                String   @default("PENDING")
  idempotencyKey        String   @unique
  contentSnapshot       Json?
  templateSnapshot      Json?
  driverVehicleSnapshot Json?
  airportGuideSnapshot  Json?
  providerMessageId     String?  @unique
  attemptCount          Int      @default(0)
  lastError             String?
  sentAt                DateTime?
  failedAt              DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inboundMessages CustomerInboundMessage[]

  @@index([orderId, notificationType, createdAt])
  @@index([status, createdAt])
  @@index([recipientPhone, createdAt])
}

// 客人原话始终独立保存；解析结果只能补充内部沟通数据，绝不改写 i’way 原始订单字段。
model CustomerInboundMessage {
  id                     String   @id @default(cuid())
  orderId                String?
  customerNotificationId String?
  senderPhone            String
  providerMessageId      String?  @unique
  rawText                String
  parseStatus            String   @default("PENDING")
  parsedSnapshot         Json?
  receivedAt             DateTime @default(now())
  createdAt              DateTime @default(now())

  order                Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerNotification CustomerNotification? @relation(fields: [customerNotificationId], references: [id], onDelete: SetNull)

  @@index([orderId, receivedAt])
  @@index([senderPhone, receivedAt])
}

// 只有确实需要运营人员处理的客户沟通问题才出现在订单首页。
model CustomerCommunicationException {
  id             String   @id @default(cuid())
  orderId        String
  exceptionType  String
  severity       String   @default("WARNING")
  status         String   @default("OPEN")
  idempotencyKey String   @unique
  details        Json?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status, createdAt])
  @@index([status, severity, createdAt])
}

// 初始不预置任何车型容量，避免系统凭空猜测车队承载能力。
// 运营人员可按已确认的真实车型资料维护这些阈值。
model VehicleCapacityRule {
  id                    String   @id @default(cuid())
  vehicleModel          String   @unique
  normalizedVehicleModel String  @unique
  maxPassengers         Int?
  normalLargeLuggage    Int?
  warningLargeLuggage   Int?
  note                  String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([isActive, normalizedVehicleModel])
}

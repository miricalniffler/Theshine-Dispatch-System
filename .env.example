# 本机与线上网站使用同一份 PostgreSQL 数据库。请将实际连接地址仅保存在 .env 中。
# DATABASE_URL：网站运行时使用的连接地址；DIRECT_URL：用于创建和更新数据表。
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres"

# 阿里云百炼 Qwen（请只在本机 .env 填写真实值，不要提交到 Git）
# 网站线上运行时，请在 Vercel 的加密环境变量中设置同名值。
DASHSCOPE_API_KEY=""
ZHIPU_API_KEY=""
# 默认关闭：仅在确认预算后设为 true，车辆/截图识别才会调用 GLM，并在失败后调用 Qwen。
AI_VISION_REAL_CALLS_ENABLED="false"
# 泰文司机姓名音译与图片识别分开控制，默认同样关闭。
AI_NAME_TRANSLITERATION_ENABLED="false"

# 飞书邮件同步（可选）。必须使用已授权的“邮件桥接”服务，不能填写飞书账号密码。
# Preview 不会运行 Vercel 的定时任务；配置桥接后可从订单工作台手动触发一次安全同步。
FEISHU_MAIL_IMPORT_ENABLED="false"
FEISHU_MAIL_IMPORT_URL=""
FEISHU_MAIL_IMPORT_TOKEN=""
FEISHU_MAIL_ALLOWED_SENDER="control@iwayex.com,noreply@iway.ru"
FEISHU_MAIL_SYNC_ENABLED="false"
CRON_SECRET="generate-a-long-random-cron-token"

# 团队统一访问密码（请只在 .env 与 Vercel 的加密设置中保存）
TEAM_ACCESS_PASSWORD="choose-a-strong-team-password"
TEAM_ACCESS_TOKEN="generate-a-long-random-token"

# WP1A 机场指引图片（可选：未配置时机场指引文字仍可维护，但图片上传会明确提示未配置）
# 由 Supabase 项目账号所有者创建 bucket 后填写；SERVICE_ROLE_KEY 只能放在 Vercel/本机 .env，绝不提交 Git。
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_AIRPORT_GUIDES_BUCKET=""

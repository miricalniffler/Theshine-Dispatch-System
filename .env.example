# 本地 SQLite 数据库（不要把 .env 或真实令牌提交到 Git）
DATABASE_URL="file:./dev.db"

# 飞书邮件：请填写一个由你们维护的“导入桥接地址”。该地址应返回 JSON 数组，或 {"items": [...]}
# 每个邮件项目必须包含 sender、subject 和 text（正文也可使用 body/rawText/content）。
FEISHU_MAIL_IMPORT_ENABLED=false
FEISHU_MAIL_IMPORT_URL="https://your-import-bridge.example.com/feishu-mail"
FEISHU_MAIL_IMPORT_TOKEN=""
# 每小时同步需同时启用这两项。生产部署可使用 Vercel Cron；其他部署可让任意定时器每小时以
# Authorization: Bearer <CRON_SECRET> 请求 GET /api/cron/feishu-mail。
FEISHU_MAIL_SYNC_ENABLED=false
CRON_SECRET="replace-with-a-long-random-secret"
FEISHU_MAIL_ALLOWED_SENDER="dingdan@theshine.com.cn"

# esforty：同样使用经授权的导入桥接地址，不在浏览器或代码中保存真实账号密码。
ESFORTY_IMPORT_ENABLED=false
ESFORTY_IMPORT_URL="https://your-import-bridge.example.com/esforty"
ESFORTY_IMPORT_TOKEN=""
